# Static analysis, run in Docker by ~/work/rob/standards-mcp/run-phpstan.sh.
# No baseline: a finding is fixed, or ignored on its own line with a reason.
# Raise the level a rung at a time.
parameters:
    level: 5
    # What DreamHost runs for db.marbletrack3.com.
    phpVersion: 80500
    paths:
        - classes
        - wwwroot
        - templates
        - scripts
        - Tests
        - prepend.php
    excludePaths:
        analyseAndScan:
            # Gitignored per-server credentials; ConfigSample declares the same class.
            - classes/Config.php (?)
            # Codeception output, and the actors built from generated traits
            # that a fresh clone doesn't have.
            - Tests/_output/*
            - Tests/Support/*
        analyse:
            # Vendored from Modernizing Legacy Applications in PHP
            # (https://leanpub.com/mlaphp): read for its types, not checked.
            - classes/Mlaphp/*
    ignoreErrors:
        # Entry scripts include prepend.php by its absolute DreamHost path,
        # which exists on the server and nowhere else.
        -
            identifier: includeOnce.fileNotFound
            message: '#"/home/dh_fbrdk3/db\.marbletrack3\.com/#'
        # CLI scripts always have $argv. PHPStan doubts it on some PHP builds
        # and not others, so the entry may go unmatched.
        -
            identifier: variable.undefined
            message: '#^Variable \$argv might not be defined\.$#'
            path: scripts/*
            reportUnmatched: false
    bootstrapFiles:
        - vendor/autoload.php
